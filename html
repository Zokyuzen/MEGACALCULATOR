<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MEGACALCULATOR - Estudiantes M.C.</title>
  
  <!-- Google Fonts & Tailwind CSS CDN -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Enlace al archivo CSS externo -->
  <link rel="stylesheet" href="styles.css">
</head>
<body class="p-4 sm:p-6 md:p-8 min-h-screen">

  <div class="max-w-6xl mx-auto space-y-6">

    <!-- ENCABEZADO SUPERIOR -->
    <header class="paper-card rounded-2xl p-6 relative border-4 border-emerald-700 bg-amber-50">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="flex items-center gap-4">
          <div class="text-5xl">🍎</div>
          <div>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-amber-900 tracking-wider">
              MEGACALCULATOR
            </h1>
            <p class="text-xl font-bold text-amber-700 italic">Estudiantes M.C.</p>
            <p class="text-sm font-semibold text-emerald-800 tracking-wide mt-1">
              "Promediamos tus notas"
            </p>
          </div>
        </div>

        <div class="bg-amber-100/80 border-2 border-dashed border-amber-500 rounded-xl p-3 text-right max-w-xs text-xs font-semibold text-amber-900">
          <p class="flex items-center justify-end gap-1 font-bold text-amber-800 text-sm">
            <span>📌</span> Priorizar nuestro trabajo
          </p>
          <p>es mantener tus notas a salvo 📑✌️</p>
          <p class="mt-1 text-[11px] text-amber-700 font-bold">Nota mínima para pasar: 35 / 50</p>
        </div>
      </div>
    </header>

    <!-- GRID PRINCIPAL (3 COLUMNAS/MÓDULOS) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- MÓDULO 1: AGREGAR EJERCICIO (VERDE) -->
      <section class="handdrawn-box bg-emerald-50 rounded-2xl p-5 border-emerald-600 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between border-b-2 border-emerald-300 pb-2 mb-4">
            <h2 class="text-xl font-bold text-emerald-900 flex items-center gap-2">
              <span>✍️</span> Agregar ejercicio:
            </h2>
            <span class="text-xs bg-emerald-200 text-emerald-800 px-2 py-0.5 rounded-full font-bold">Movible ⬆</span>
          </div>

          <div class="space-y-3 text-sm font-semibold">
            <div>
              <label class="block text-emerald-900 mb-1">Fecha:</label>
              <input type="date" id="fecha" class="w-full bg-white border-2 border-emerald-400 rounded-lg p-2 focus:outline-none focus:border-emerald-600">
            </div>

            <div>
              <label class="block text-emerald-900 mb-1">Nombre estudiante:</label>
              <input type="text" id="estudiante" placeholder="Insert name..." class="w-full bg-white border-2 border-emerald-400 rounded-lg p-2 focus:outline-none focus:border-emerald-600">
            </div>

            <!-- FÓRMULA / INPUTS PERIODO -->
            <div class="mt-4 pt-2 border-t border-emerald-200">
              <label class="block text-emerald-900 font-bold mb-2">Nota del Periodo:</label>
              
              <div class="bg-white/80 p-3 rounded-xl border border-emerald-300">
                <div class="flex items-center justify-center gap-2 mb-1">
                  <div class="flex flex-col items-center">
                    <span class="text-[10px] text-emerald-700 font-bold">Periodo 1</span>
                    <input type="number" id="p1" min="0" max="50" placeholder="0" class="w-14 text-center border-2 border-emerald-400 rounded p-1 font-bold">
                  </div>
                  <span class="text-lg font-bold text-emerald-700">+</span>
                  <div class="flex flex-col items-center">
                    <span class="text-[10px] text-emerald-700 font-bold">Periodo 2</span>
                    <input type="number" id="p2" min="0" max="50" placeholder="0" class="w-14 text-center border-2 border-emerald-400 rounded p-1 font-bold">
                  </div>
                  <span class="text-lg font-bold text-emerald-700">+</span>
                  <div class="flex flex-col items-center">
                    <span class="text-[10px] text-emerald-700 font-bold">Periodo 3</span>
                    <input type="number" id="p3" min="0" max="50" placeholder="0" class="w-14 text-center border-2 border-emerald-400 rounded p-1 font-bold">
                  </div>
                </div>
                <div class="w-full border-t-2 border-emerald-800 my-1"></div>
                <div class="text-center font-bold text-emerald-900 text-lg">3</div>
              </div>
            </div>
          </div>
        </div>

        <!-- BOTONES DE ACCIÓN -->
        <div class="mt-6 space-y-2">
          <div class="grid grid-cols-3 gap-2">
            <button id="btnCancelar" class="btn-handdrawn bg-rose-200 text-rose-800 border-rose-400 hover:bg-rose-300 font-bold py-2 rounded-xl text-xs">Cancelar</button>
            <button id="btnCalcular" class="btn-handdrawn bg-emerald-300 text-emerald-900 border-emerald-500 hover:bg-emerald-400 font-bold py-2 rounded-xl text-xs">Calcular</button>
            <button id="btnGuardar" class="btn-handdrawn bg-teal-300 text-teal-900 border-teal-500 hover:bg-teal-400 font-bold py-2 rounded-xl text-xs">Guardar</button>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <button id="btnEditar" class="btn-handdrawn bg-emerald-400 text-emerald-950 border-emerald-600 hover:bg-emerald-500 font-bold py-2 rounded-xl text-xs flex items-center justify-center gap-1">
              ✏️ Editar
            </button>
            <button id="btnBorrar" class="btn-handdrawn bg-rose-400 text-rose-950 border-rose-600 hover:bg-rose-500 font-bold py-2 rounded-xl text-xs">Borrar</button>
          </div>
        </div>
      </section>

      <!-- MÓDULO 2: RESULTADO (NARANJA) -->
      <section class="handdrawn-box bg-orange-50 rounded-2xl p-5 border-orange-500 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between border-b-2 border-orange-200 pb-2 mb-4">
            <h2 class="text-xl font-bold text-orange-950 flex items-center gap-2">
              <span>📊</span> Resultado:
            </h2>
            <span class="text-xs bg-orange-200 text-orange-800 px-2 py-0.5 rounded-full font-bold">📄</span>
          </div>

          <!-- MUESTRA DE FÓRMULA -->
          <div class="bg-white/80 border border-orange-300 rounded-xl p-3 mb-4 text-center">
            <p class="text-xs font-bold text-orange-800 uppercase tracking-wider mb-1">Fórmula</p>
            <div class="inline-block border-b-2 border-orange-900 font-bold text-orange-900 px-4 pb-0.5">
              ∑ Suma de todas las notas
            </div>
            <div class="font-bold text-orange-900 text-base">3</div>
          </div>

          <!-- MUESTRA DE EJEMPLO / PASO A PASO -->
          <div class="bg-white/60 border border-orange-200 rounded-xl p-3 font-mono text-xs space-y-1 text-amber-950">
            <p class="font-sans font-bold text-orange-800 mb-1 border-b border-orange-200 pb-1">EJEMPLO / PROCEDIMIENTO</p>
            <div class="flex justify-between">
              <span>Periodo 1:</span>
              <span id="resP1" class="font-bold">0</span>
            </div>
            <div class="flex justify-between">
              <span>Periodo 2:</span>
              <span id="resP2" class="font-bold">0</span>
            </div>
            <div class="flex justify-between">
              <span>Periodo 3:</span>
              <span id="resP3" class="font-bold">0</span>
            </div>
            <div class="border-t border-orange-300 pt-1 text-center font-bold">
              <span id="resSuma">0 + 0 + 0 = 0</span>
            </div>
            <div class="text-center font-bold text-orange-900">
              <span id="resDivision">0 ÷ 3 = 0</span>
            </div>
          </div>
        </div>

        <!-- MUESTRA DE PROMEDIO Y ESTADO (PASASTE / NO PASASTE) -->
        <div class="mt-4 bg-white p-4 rounded-xl border-2 border-orange-300 text-center">
          <div class="flex justify-between items-center mb-2">
            <span class="text-xs font-bold text-gray-500 uppercase">Resultado:</span>
            <span id="promedioNum" class="text-3xl font-extrabold text-orange-900">0.0</span>
          </div>

          <!-- INDICADOR DINÁMICO (CRITERIO: >= 35) -->
          <div id="badgeResultado" class="py-2 px-4 rounded-xl border-2 font-bold text-sm bg-gray-100 border-gray-300 text-gray-500">
            Esperando datos...
          </div>
        </div>

        <div class="text-center mt-3 text-[11px] text-orange-800 font-semibold">
          📱 Plataforma movible
        </div>
      </section>

      <!-- MÓDULO 3: LISTA DE EJERCICIOS Y MASCOTA (MORADO) -->
      <section class="space-y-6 flex flex-col justify-between">
        
        <!-- LISTA DE EJERCICIOS -->
        <div class="handdrawn-box bg-purple-50 rounded-2xl p-5 border-purple-500 flex-1">
          <div class="flex items-center justify-between border-b-2 border-purple-200 pb-2 mb-3">
            <h2 class="text-xl font-bold text-purple-950 flex items-center gap-2">
              <span>📑</span> Lista de ejercicios
            </h2>
            <span class="text-xs bg-purple-200 text-purple-800 px-2 py-0.5 rounded-full font-bold">Historial</span>
          </div>

          <!-- TABLA INTERACTIVA -->
          <div class="bg-white rounded-xl border border-purple-200 overflow-hidden shadow-inner max-h-56 overflow-y-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-purple-100 text-purple-900 font-bold border-b border-purple-200">
                <tr>
                  <th class="p-2">Nombre</th>
                  <th class="p-2 text-center">Nota</th>
                  <th class="p-2 text-center">Fecha</th>
                  <th class="p-2 text-center">√/X</th>
                </tr>
              </thead>
              <tbody id="tablaEjercicios" class="divide-y divide-purple-100 font-medium">
                <!-- Se rellena dinámicamente desde JS -->
              </tbody>
            </table>
          </div>

          <p class="text-[11px] text-purple-700 text-center mt-2 italic font-semibold">
            Desplaza para más información 🔽
          </p>
        </div>

        <!-- MASCOTA Y MENSAJE DE ADVERTENCIA/ÁNIMO -->
        <div class="paper-card bg-teal-50 border-2 border-teal-500 rounded-2xl p-4 flex items-center gap-4 relative overflow-visible">
          <div class="relative flex-shrink-0">
            <div class="w-16 h-16 bg-teal-200 rounded-full border-2 border-teal-600 flex items-center justify-center text-3xl shadow">
              👩‍🏫
            </div>
            <div class="absolute -bottom-2 -right-1 bg-amber-200 border border-amber-600 text-[9px] px-1 font-bold rounded">
              45 50 35
            </div>
          </div>

          <!-- BUBBLE DE DIÁLOGO -->
          <div class="speech-bubble bg-white border-2 border-teal-600 rounded-xl p-2.5 text-xs font-bold text-teal-950 shadow-sm relative">
            "¡Cuidas tus notas y serán calculadas!"
          </div>
        </div>

      </section>

    </div>
  </div>

  <!-- Enlace al archivo JavaScript externo -->
  <script src="script.js"></script>
</body>
</html>